    <script>
      (function () {
        var stars = document.querySelectorAll(".twinkle-star");
        stars.forEach(function (s) {
          var delay = parseFloat(s.getAttribute("data-delay")) || 0;
          var period = 4000;
          function cycle() {
            s.textContent = "*";
            setTimeout(function () {
              s.textContent = ".";
            }, period / 2);
          }
          setTimeout(function () {
            cycle();
            setInterval(cycle, period);
          }, delay * 1000);
        });
      })();
    </script>
